{
  "name": "dsh-smart-websearch",
  "version": "0.3.0",
  "description": "Smart web search + fetch provider for DeepSeek Harness. Auto-detects local HTTP proxy ports (fallback 7890), routes CN direct / overseas via proxy, hedged multi-engine fallback, detailed error diagnostics, boilerplate pruning, SPA JSON recovery, and a Settings UI.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "client/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.4.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || >=4.0.6-alpha.2 <5.0.0",
    "@deepseek-ai/dsh-web": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2 || >=3.18.6-alpha.2 <4.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "web-search",
    "bing",
    "baidu",
    "duckduckgo",
    "smart-search",
    "search-hygiene"
  ],
  "license": "Apache-2.0"
}
